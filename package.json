{
  "name": "rns-event-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Event management web app for RNS First Grade College (RNSFC) — Next.js + Firebase with auth, Firestore, and storage",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.ts",
    "setup:admin": "node scripts/seed-admin.mjs",
    "screenshots": "node scripts/screenshots.cjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.62.1",
    "postcss": "^8.4.38",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.0"
  }
}
